{
  "name": "vp-gestao",
  "version": "1.0.0",
  "description": "VP Gestão — VerticalParts WMS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "eslint .",
    "test": "node scripts/run-tests.js",
    "test:e2e": "playwright test",
    "a11y:relatorio": "node scripts/a11y-relatorio.js",
    "tutoriais:conferir": "node scripts/conferir-tutoriais.mjs",
    "rag": "node scripts/gerar-rag.js",
    "rag:conferir": "node scripts/gerar-rag.js --conferir",
    "docs:conferir": "node scripts/check-docs-em-dia.js",
    "build": "npm run build:pdf && npm run build:pdf:proposta && npm run build:pdf:vistoria && npm run build:pdf:contrato && npm run build:pdf:qc",
    "build:pdf": "cross-env PDF_ENTRY=pedido vite build --config pdf-bundle/vite.config.js",
    "build:pdf:proposta": "cross-env PDF_ENTRY=proposta vite build --config pdf-bundle/vite.config.js",
    "build:pdf:vistoria": "cross-env PDF_ENTRY=vistoria vite build --config pdf-bundle/vite.config.js",
    "build:pdf:contrato": "cross-env PDF_ENTRY=contrato vite build --config pdf-bundle/vite.config.js",
    "build:pdf:qc": "cross-env PDF_ENTRY=qc vite build --config pdf-bundle/vite.config.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@react-pdf/renderer": "^4.6.1",
    "@vitejs/plugin-react": "^6.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "vite": "^8.2.2"
  }
}
